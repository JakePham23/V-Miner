# ═══════════════════════════════════════════════════════════════════
#  LightOnOCR Configuration — Copy sang .env rồi chỉnh giá trị
# ═══════════════════════════════════════════════════════════════════

# ── Loại dịch vụ LLM ─────────────────────────────────────────────
# "openai"     → dùng API tương thích OpenAI (LM Studio, OpenAI thật, Azure, v.v.)
# "azure"      → Azure OpenAI (cũng dùng OPENAI_API_BASE / OPENAI_API_KEY)
# "anthropic"  → Anthropic Claude API
# "local"      → Chỉ dùng model local, không gọi API
# Mặc định: "openai"
LLM_SERVICE=openai

# ── OpenAI-compatible API ─────────────────────────────────────────
# Dùng cho LM Studio, OpenAI, Azure, bất kỳ server tương thích OpenAI

# API Key:
#   - LM Studio local : "lm-studio" (hoặc để trống)
#   - OpenAI thật     : "sk-proj-..."
#   - Azure           : Azure OpenAI key
OPENAI_API_KEY=lm-studio

# Base URL (không cần /chat/completions — tự thêm):
#   - LM Studio local : http://localhost:1234/v1
#   - OpenAI thật     : https://api.openai.com/v1
#   - Azure           : https://<resource>.openai.azure.com/openai/deployments/<model>
OPENAI_API_BASE=http://localhost:1234/v1

# Tên model (phải khớp với model đang load trong LM Studio hoặc tên trên API):
#   - LM Studio : tên bạn đặt trong LM Studio UI
#   - OpenAI    : "gpt-4o", "gpt-4o-mini", ...
OPENAI_MODEL=lightonocr

# ── Local Model (fallback khi API không có) ───────────────────────
# Model HuggingFace ID để tải về máy và chạy offline.
# Tải tự động vào ~/.cache/huggingface lần đầu.

# MLX (Apple Silicon — nhanh, ít RAM):
LOCAL_MODEL_ID=mlx-community/LightOnOCR-2-1B-bf16
LOCAL_MODEL_BACKEND=mlx

# Transformers (CPU / CUDA — cross-platform):
# LOCAL_MODEL_ID=lightonai/LightOnOCR-2-1B
# LOCAL_MODEL_BACKEND=transformers

# ── Backward compatible (vẫn hoạt động, ưu tiên thấp hơn) ────────
# LIGHTON_SERVER_URL=http://localhost:1234/v1/chat/completions
# LIGHTON_MODEL_NAME=lightonocr
